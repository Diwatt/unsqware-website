{
  "name": "unsqware-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr scripts/prerender.tsx --outDir .prerender && node .prerender/prerender.js",
