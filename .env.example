# Copiez ce fichier vers .env.local (ignoré par git) et remplissez vos valeurs.
# En production, renseignez ces variables dans les réglages du build.

# ID de l'agenda Google : calendar.google.com → réglages de l'agenda
# → « Intégrer l'agenda » → « ID de l'agenda »
VITE_CALENDAR_ID=

# Clé API Google : console.cloud.google.com → APIs & Services → Identifiants
# (restreinte à l'API Calendar + aux référents du site)
VITE_CALENDAR_API_KEY=
